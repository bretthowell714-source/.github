# Claude Customization Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ==================== API Keys ====================

# Anthropic API Key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Token (create at https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== Claude Code Configuration ====================

# Claude Code model to use
CLAUDE_CODE_MODEL=claude-opus-4-5-20251101

# Claude Code CLI version
CLAUDE_CODE_CLI_VERSION=latest

# Enable debug logging
DEBUG=false

# ==================== Database Configuration ====================

# PostgreSQL
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=mydb

# MongoDB (optional)
MONGO_URI=mongodb://localhost:27017/mydb

# Redis (optional)
REDIS_URL=redis://localhost:6379

# ==================== Tool Configuration ====================

# Enable/disable custom tools
ENABLE_CUSTOM_TOOLS=true

# Tool execution timeout (ms)
TOOL_TIMEOUT=30000

# Max retries for tool execution
MAX_RETRIES=3

# ==================== MCP Server Configuration ====================

# MCP Server port
MCP_SERVER_PORT=8000

# Enable experimental MCP features
MCP_ENABLE_EXPERIMENTAL=false

# ==================== Cloud Platform Configuration ====================

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Cloud
GOOGLE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_TENANT_ID=

# ==================== Service Configuration ====================

# Service URLs
API_URL=http://localhost:3000
WEBHOOK_URL=http://localhost:8000/webhook

# Service tokens
SERVICE_TOKEN=
WEBHOOK_SECRET=

# ==================== Logging Configuration ====================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/app.log

# Max log file size (bytes)
LOG_MAX_SIZE=10485760

# ==================== Performance Configuration ====================

# Enable parallel operations
ENABLE_PARALLEL_OPS=true

# Max concurrent tasks
MAX_CONCURRENT_TASKS=5

# Enable streaming responses
ENABLE_STREAMING=true

# Token budget per request
TOKEN_BUDGET=4096

# ==================== Security Configuration ====================

# Require confirmation for file writes
REQUIRE_WRITE_CONFIRMATION=false

# Require confirmation for bash commands
REQUIRE_BASH_CONFIRMATION=false

# Enable sandbox mode
SANDBOX_MODE=true

# Verify git operations
VERIFY_GIT_OPS=true

# ==================== Cache Configuration ====================

# Web cache TTL (ms)
WEB_CACHE_TTL=900000

# Response cache TTL (ms)
RESPONSE_CACHE_TTL=300000

# Enable response caching
ENABLE_RESPONSE_CACHE=true

# ==================== Workspace Configuration ====================

# Workspace name
WORKSPACE_NAME=Claude Customization Workspace

# Custom tools path
CUSTOM_TOOLS_PATH=./tools/custom

# Extensions path
EXTENSIONS_PATH=./extensions

# Plugins path
PLUGINS_PATH=./plugins

# ==================== Development Configuration ====================

# Node environment
NODE_ENV=development

# Port for local development
PORT=3000

# Enable hot reload
HOT_RELOAD=true

# Watch paths for changes
WATCH_PATHS=./tools,./plugins,./config
